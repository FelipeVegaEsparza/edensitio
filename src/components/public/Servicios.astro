---
import { getSection } from '../../lib/content'
const { title, desc, rehab_title, rehab_text, hombre_title, hombre_text, mujer_title, mujer_text } = getSection('servicios')
const cards = [
  { img: '/images/servicio-rehabilitacion.jpg', title: rehab_title || 'Rehabilitación', text: rehab_text },
  { img: '/images/servicio-hombres.jpg', title: hombre_title || 'Para Hombres', text: hombre_text },
  { img: '/images/servicio-mujeres.jpg', title: mujer_title || 'Para Mujeres', text: mujer_text },
].filter(c => c.text)
---

<section id="servicios">
  <div class="container">
    <div class="fade-in">
      <div class="section-label">Nuestro Servicio</div>
      <h2 class="section-title">{title || 'Programas de rehabilitación'}</h2>
      {desc && <p class="section-desc">{desc}</p>}
    </div>
    <div class="servicios-grid">
      {cards.map(card => (
        <div class="servicio-card fade-in">
          <div class="card-image"><img src={card.img} alt={card.title} loading="lazy" /></div>
          <div class="card-body">
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </div>
        </div>
      ))}
    </div>
    <div style="text-align:center;margin-top:40px">
      <a href="/servicios" class="btn btn-primary">Ver proyectos</a>
    </div>
  </div>
</section>

<style>
  #servicios { background: var(--warm-gray); }
  .servicios-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; margin-top: 48px; }
  .servicio-card {
    background: var(--white); border-radius: var(--radius);
    box-shadow: var(--shadow); transition: var(--transition);
    overflow: hidden; display: flex; flex-direction: column;
  }
  .servicio-card:hover { transform: translateY(-8px); box-shadow: var(--shadow-lg); }
  .servicio-card .card-image { width: 100%; height: 220px; overflow: hidden; }
  .servicio-card .card-image img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .servicio-card:hover .card-image img { transform: scale(1.08); }
  .servicio-card .card-body { padding: 32px; flex: 1; }
  .servicio-card h3 { font-size: 1.3rem; margin-bottom: 12px; color: var(--green-900); font-family: 'Playfair Display', serif; }
  .servicio-card p { color: var(--text-muted); font-size: 0.94rem; line-height: 1.7; }
  .btn-primary { background: var(--gold); color: var(--green-900); }
  @media (max-width: 968px) { .servicios-grid { grid-template-columns: 1fr; } }
</style>
