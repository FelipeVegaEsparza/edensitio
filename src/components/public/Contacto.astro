---
import { getSection } from '../../lib/content'
const d = getSection('contacto')
const wa = (v: string) => 'https://wa.me/' + (v || '').replace(/\D/g, '')
---

<section id="contacto">
  <div class="container">
    <div class="fade-in">
      <div class="section-label">Contacto</div>
      <h2 class="section-title">{d.title || 'Hablemos'}</h2>
      <p class="section-desc">{d.text || '¿Tienes dudas o quieres más información? Escríbenos y te responderemos a la brevedad.'}</p>
    </div>
    <div class="contacto-grid">
      <div class="contacto-info fade-in">
        <h3>Información de contacto</h3>
        <p>Estamos disponibles para atenderte y brindarte la orientación que necesites.</p>
        {d.email && <a class="contacto-item" href={`mailto:${d.email}`}><span class="emoji">✉️</span><span>{d.email}</span></a>}
        {d.whatsapp_masculino && <a class="contacto-item" href={wa(d.whatsapp_masculino)} target="_blank" rel="noopener"><span class="emoji">💬</span><span>WhatsApp Masculino · {d.whatsapp_masculino}</span></a>}
        {d.whatsapp_femenino && <a class="contacto-item" href={wa(d.whatsapp_femenino)} target="_blank" rel="noopener"><span class="emoji">💬</span><span>WhatsApp Femenino · {d.whatsapp_femenino}</span></a>}
        {d.address_1 && <div class="contacto-item"><span class="emoji">📍</span><span>{d.address_label_1}: {d.address_1}</span></div>}
      </div>
      <div class="contacto-cta fade-in">
        <div class="section-label" style="color: var(--gold);">Radio El Edén</div>
        <h3>Estamos online 24/7</h3>
        <p>Acompáñanos en nuestra señal radial con contenido edificante.</p>
        <div class="cta-buttons">
          <a href="/contacto" class="btn btn-primary">Ir a contacto</a>
          <a href="/donaciones" class="btn btn-outline">Donar</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #contacto { background: var(--white); }
  .contacto-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 60px; margin-top: 48px; align-items: center; }
  .contacto-info h3 { font-size: 1.3rem; color: var(--green-900); margin-bottom: 16px; }
  .contacto-info p { color: var(--text-muted); margin-bottom: 24px; line-height: 1.7; }
  .contacto-item { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; color: var(--text-muted); font-size: 0.95rem; }
  .contacto-item:hover { color: var(--green-700); }
  .contacto-item .emoji { font-size: 1.2rem; }
  .contacto-cta {
    background: linear-gradient(135deg, var(--green-900), var(--green-800));
    border-radius: var(--radius); padding: 40px;
  }
  .contacto-cta h3 { color: var(--white); font-size: 1.4rem; margin-bottom: 12px; }
  .contacto-cta p { color: rgba(255,255,255,0.7); line-height: 1.7; margin-bottom: 24px; }
  .cta-buttons { display: flex; gap: 14px; flex-wrap: wrap; }
  .btn-primary { background: var(--gold); color: var(--green-900); }
  .btn-outline { background: transparent; color: var(--white); border: 1.5px solid rgba(255,255,255,0.25); }
  .btn-outline:hover { border-color: var(--gold); color: var(--gold); }
  @media (max-width: 968px) { .contacto-grid { grid-template-columns: 1fr; gap: 40px; } }
</style>
