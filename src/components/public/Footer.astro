---
import { getSection } from '../../lib/content'
const { brand_text, copyright, email, phone, address, facebook, instagram, youtube } = getSection('footer')
const year = new Date().getFullYear()
---

<footer>
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <h3>El<span>Edén</span></h3>
        <p>{brand_text || 'Centro de Rehabilitación comprometido con la restauración integral de personas afectadas por el alcohol y las drogas.'}</p>
        <div class="footer-socials">
          {facebook && <a href={facebook} aria-label="Facebook" target="_blank" rel="noopener">📘</a>}
          {instagram && <a href={instagram} aria-label="Instagram" target="_blank" rel="noopener">📷</a>}
          {youtube && <a href={youtube} aria-label="YouTube" target="_blank" rel="noopener">▶️</a>}
        </div>
      </div>
      <div>
        <h4>Navegación</h4>
        <ul>
          <li><a href="/">Inicio</a></li>
          <li><a href="/quienes-somos">Quiénes Somos</a></li>
          <li><a href="/instalaciones-y-equipos">Instalaciones</a></li>
          <li><a href="/servicios">Servicios</a></li>
        </ul>
      </div>
      <div>
        <h4>Más</h4>
        <ul>
          <li><a href="/videos">Videos</a></li>
          <li><a href="/donaciones">Donaciones</a></li>
          <li><a href="/yo-soy-socio">Yo Soy Socio</a></li>
          <li><a href="/contacto">Contacto</a></li>
        </ul>
      </div>
      <div>
        <h4>Contacto</h4>
        <ul>
          {email && <li><a href={`mailto:${email}`}>{email}</a></li>}
          {phone && <li><a href={`tel:${phone.replace(/\s/g, '')}`}>{phone}</a></li>}
          {address && <li><span class="footer-address">{address}</span></li>}
          <li><a href="/admin/dashboard">Sistema</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>{copyright || `© ${year} Fundación El Edén. Todos los derechos reservados.`}</p>
      <p class="footer-credit">Sitio modernizado · Fundación El Edén</p>
    </div>
  </div>
</footer>

<style>
  footer { background: var(--green-900); padding: 56px 0 32px; }
  .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1.2fr; gap: 40px; margin-bottom: 40px; }
  .footer-brand h3 { font-family: 'Playfair Display', serif; color: var(--white); font-size: 1.4rem; margin-bottom: 12px; }
  .footer-brand h3 span { color: var(--gold); }
  .footer-brand p { color: rgba(255,255,255,0.5); font-size: 0.85rem; line-height: 1.7; max-width: 300px; }
  .footer-socials { display: flex; gap: 14px; margin-top: 18px; }
  .footer-socials a { font-size: 1.2rem; opacity: 0.7; transition: var(--transition); }
  .footer-socials a:hover { opacity: 1; transform: translateY(-2px); }
  footer h4 { color: var(--white); font-size: 0.9rem; margin-bottom: 16px; font-family: 'Inter', sans-serif; font-weight: 600; }
  footer ul { list-style: none; }
  footer ul li { margin-bottom: 10px; }
  footer ul a, .footer-address { color: rgba(255,255,255,0.5); font-size: 0.85rem; transition: var(--transition); word-break: break-word; }
  footer ul a:hover { color: var(--gold); }
  .footer-bottom { border-top: 1px solid rgba(255,255,255,0.06); padding-top: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; }
  .footer-bottom p { color: rgba(255,255,255,0.3); font-size: 0.8rem; }
  .footer-credit { letter-spacing: 0.5px; }
  @media (max-width: 968px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .footer-grid { grid-template-columns: 1fr; gap: 28px; } }
</style>
