---
import { getSection } from '../../lib/content'
const { title, text, status_text, btn_text, btn_url } = getSection('radio')
const streamUrl = btn_url || 'https://eleden.ipstream.cl/'
---

<section id="radio" class="radio-section">
  <div class="radio-glow"></div>
  <div class="container">
    <div class="radio-grid">
      <div class="radio-content fade-in">
        <div class="section-label light">Radio El Edén</div>
        <h2 class="section-title light">{title || 'Estamos online 24/7'}</h2>
        <p class="section-desc light">{text || 'Acompañamos tu proceso de recuperación también a través de nuestra señal radial con contenido edificante.'}</p>
        <div class="radio-actions">
          <a href={streamUrl} class="btn-radio" target="_blank" rel="noopener">
            <span class="icon">🎧</span>
            {btn_text || 'Escuchar la radio en vivo'}
          </a>
          <div class="live-badge">
            <span class="dot"></span>
            {status_text || 'En vivo'}
          </div>
        </div>
      </div>

      <div class="radio-player-card fade-in">
        <a href={streamUrl} class="player-link" target="_blank" rel="noopener" aria-label="Escuchar Radio El Edén en vivo">
          <div class="player-visual">
            <div class="player-ring"></div>
            <div class="player-ring player-ring-2"></div>
            <div class="player-play">▶</div>
            <div class="equalizer">
              <span></span><span></span><span></span><span></span><span></span>
            </div>
          </div>
          <div class="player-meta">
            <span class="player-station">Radio El Edén</span>
            <span class="player-cta">Toca para escuchar en vivo</span>
          </div>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .radio-section {
    position: relative;
    background: linear-gradient(135deg, var(--green-900) 0%, var(--green-800) 55%, #1b5e20 100%);
    overflow: hidden;
  }
  .radio-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 60% at 85% 20%, rgba(212,168,83,0.12) 0%, transparent 55%),
      radial-gradient(ellipse 50% 50% at 10% 90%, rgba(55,146,55,0.1) 0%, transparent 55%);
    pointer-events: none;
  }
  .radio-glow {
    position: absolute;
    top: 50%; right: 8%;
    width: 320px; height: 320px;
    transform: translateY(-50%);
    background: radial-gradient(circle, rgba(212,168,83,0.25), transparent 70%);
    filter: blur(20px);
    animation: radioGlowPulse 5s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes radioGlowPulse {
    0%, 100% { opacity: 0.5; transform: translateY(-50%) scale(1); }
    50% { opacity: 0.9; transform: translateY(-50%) scale(1.15); }
  }
  .radio-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 60px;
    align-items: center;
  }
  .radio-content .section-label { color: var(--gold); letter-spacing: 4px; }
  .radio-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 36px;
    flex-wrap: wrap;
  }
  .btn-radio {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--gold);
    color: var(--green-900);
    padding: 16px 34px;
    border-radius: 50px;
    font-weight: 700;
    font-size: 0.95rem;
    transition: var(--transition);
    box-shadow: 0 12px 40px rgba(212,168,83,0.35);
  }
  .btn-radio .icon { font-size: 1.15rem; }
  .btn-radio:hover {
    background: var(--gold-light);
    transform: translateY(-3px);
    box-shadow: 0 16px 48px rgba(212,168,83,0.5);
  }
  .live-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: rgba(255,255,255,0.75);
    font-size: 0.85rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .live-badge .dot {
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--green-500);
    box-shadow: 0 0 0 0 rgba(55,146,55,0.6);
    animation: livePulse 1.8s ease-out infinite;
  }
  @keyframes livePulse {
    0% { box-shadow: 0 0 0 0 rgba(55,146,55,0.6); }
    70% { box-shadow: 0 0 0 12px rgba(55,146,55,0); }
    100% { box-shadow: 0 0 0 0 rgba(55,146,55,0); }
  }
  .radio-player-card {
    display: flex;
    justify-content: center;
  }
  .player-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    padding: 40px 48px;
    border-radius: 28px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(212,168,83,0.2);
    backdrop-filter: blur(12px);
    transition: var(--transition);
    width: 100%;
    max-width: 380px;
  }
  .player-link:hover {
    transform: translateY(-6px);
    border-color: rgba(212,168,83,0.5);
    box-shadow: 0 24px 64px rgba(0,0,0,0.35);
  }
  .player-visual {
    position: relative;
    width: 150px; height: 150px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .player-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid rgba(212,168,83,0.35);
    animation: ringPulse 3s ease-out infinite;
  }
  .player-ring-2 { animation-delay: 1.5s; }
  @keyframes ringPulse {
    0% { transform: scale(0.85); opacity: 0.8; }
    100% { transform: scale(1.35); opacity: 0; }
  }
  .player-play {
    width: 84px; height: 84px;
    border-radius: 50%;
    background: var(--gold);
    color: var(--green-900);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.7rem;
    padding-left: 5px;
    transition: var(--transition);
    z-index: 2;
  }
  .player-link:hover .player-play {
    background: var(--gold-light);
    transform: scale(1.08);
  }
  .equalizer {
    position: absolute;
    bottom: -6px;
    display: flex;
    align-items: flex-end;
    gap: 5px;
    height: 26px;
    z-index: 2;
  }
  .equalizer span {
    width: 5px;
    background: var(--green-500);
    border-radius: 3px;
    animation: eq 1.2s ease-in-out infinite;
  }
  .equalizer span:nth-child(1) { animation-delay: 0s; }
  .equalizer span:nth-child(2) { animation-delay: 0.2s; }
  .equalizer span:nth-child(3) { animation-delay: 0.4s; }
  .equalizer span:nth-child(4) { animation-delay: 0.6s; }
  .equalizer span:nth-child(5) { animation-delay: 0.8s; }
  @keyframes eq {
    0%, 100% { height: 8px; }
    50% { height: 26px; }
  }
  .player-meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-align: center;
  }
  .player-station {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--white);
  }
  .player-cta {
    font-size: 0.82rem;
    color: rgba(255,255,255,0.6);
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  @media (max-width: 968px) {
    .radio-grid { grid-template-columns: 1fr; gap: 48px; text-align: center; }
    .radio-content .section-desc { margin: 0 auto; }
    .radio-actions { justify-content: center; }
    .radio-glow { right: 50%; transform: translate(50%, -50%); animation: none; }
  }
  @media (max-width: 600px) {
    .player-link { padding: 32px 24px; }
    .btn-radio { width: 100%; justify-content: center; }
  }
</style>
