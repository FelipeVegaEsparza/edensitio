---
import { getSection } from '../../lib/content'
const d = getSection('donaciones')
const planes = [1, 2, 3, 4, 5, 6].map(i => ({
  amount: d[`amount_${i}`] || '',
  label: d[`label_${i}`] || '',
})).filter(p => p.amount).slice(0, 3)
const formatCLP = (v: string) => {
  const n = parseInt(v.replace(/\D/g, ''), 10)
  return isNaN(n) ? v : '$' + n.toLocaleString('es-CL')
}
---

<section id="donaciones">
  <div class="container">
    <div class="donaciones-content fade-in">
      <div class="section-label" style="color: var(--gold);">Donaciones</div>
      <h2 class="section-title light">{d.title || 'Si te interesa aportar a esta causa'}</h2>
      <p>{d.text || 'Apoya nuestras sucursales para seguir ayudando a personas que necesitan rehabilitarse y perseverar en su vida.'}</p>
      <div class="donaciones-options">
        {planes.map(p => (
          <div class="donacion-option">
            <div class="amount">{formatCLP(p.amount)}</div>
            <span>{p.label}</span>
          </div>
        ))}
      </div>
      <a href="/donaciones" class="btn btn-primary" style="margin-top: 32px;">Donar ahora</a>
    </div>
  </div>
</section>

<style>
  #donaciones { background: linear-gradient(135deg, var(--green-900), var(--green-800)); text-align: center; }
  .donaciones-content { max-width: 640px; margin: 0 auto; }
  .donaciones-content p { color: rgba(255,255,255,0.7); margin-bottom: 32px; line-height: 1.7; }
  .donaciones-options { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
  .donacion-option {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: var(--radius); padding: 32px 28px;
    min-width: 170px; transition: var(--transition); cursor: pointer;
  }
  .donacion-option:hover { background: rgba(255,255,255,0.1); transform: translateY(-4px); }
  .donacion-option .amount { font-family: 'Playfair Display', serif; font-size: 1.9rem; font-weight: 700; color: var(--gold); }
  .donacion-option span { display: block; color: rgba(255,255,255,0.5); font-size: 0.8rem; margin-top: 8px; }
  .btn-primary { background: var(--gold); color: var(--green-900); }
</style>
