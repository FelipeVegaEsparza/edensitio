---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/public/Header.astro'
import PageHero from '../components/public/PageHero.astro'
import Footer from '../components/public/Footer.astro'
import { getSection } from '../lib/content'

const d = getSection('servicios')
const title = d.title || 'Nuestro Servicio'

const servicios = [
  { img: '/images/servicio-rehabilitacion.jpg', title: d.rehab_title || 'Rehabilitación', text: d.rehab_text },
  { img: '/images/servicio-hombres.jpg', title: d.hombre_title || 'Para Hombres', text: d.hombre_text },
  { img: '/images/servicio-mujeres.jpg', title: d.mujer_title || 'Para Mujeres', text: d.mujer_text },
].filter(s => s.text)
---

<BaseLayout title={`${title} – Fundación El Edén`} description="Programas de rehabilitación para hombres y mujeres: Proyecto Restauración de Fundación El Edén.">
  <Header />
  <PageHero
    title={title}
    subtitle={d.desc}
    label="Servicios"
    image="/images/servicios-hero.jpg"
  />

  <section id="servicios">
    <div class="container">
      <div class="servicios-grid">
        {servicios.map((s, i) => (
          <div class="servicio-card fade-in">
            <div class="card-image"><img src={s.img} alt={s.title} loading="lazy" /></div>
            <div class="card-body">
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="proyecto">
    <div class="container">
      <div class="section-header fade-in">
        <div class="section-label" style="color: var(--gold);">Programa</div>
        <h2 class="section-title light">{d.proyecto_title || 'Proyecto Restauración'}</h2>
      </div>
      <div class="proyecto-grid">
        <div class="proyecto-block fade-in">
          <h3>{d.objetivos_title || 'Objetivos del Tratamiento'}</h3>
          <p>{d.objetivos_text}</p>
        </div>
        <div class="proyecto-image fade-in">
          <img src="/images/terapia-5.jpg" alt="Proceso de rehabilitación" loading="lazy" />
        </div>
        <div class="proyecto-image fade-in">
          <img src="/images/terapia-2.jpg" alt="Terapia grupal" loading="lazy" />
        </div>
        <div class="proyecto-block fade-in">
          <h3>{d.espera_title || 'Lo que se espera'}</h3>
          <p>{d.espera_text}</p>
        </div>
      </div>
      <div class="cta fade-in" style="text-align:center;margin-top:64px">
        <a href="/contacto" class="btn btn-primary">Contactar</a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  #servicios { background: var(--cream); }
  .servicios-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .servicio-card { background: var(--white); border-radius: var(--radius); box-shadow: var(--shadow); overflow: hidden; transition: var(--transition); display: flex; flex-direction: column; }
  .servicio-card:hover { transform: translateY(-8px); box-shadow: var(--shadow-lg); }
  .card-image { height: 240px; overflow: hidden; }
  .card-image img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .servicio-card:hover .card-image img { transform: scale(1.08); }
  .card-body { padding: 32px; flex: 1; }
  .card-body h3 { font-size: 1.3rem; margin-bottom: 12px; color: var(--green-900); font-family: 'Playfair Display', serif; }
  .card-body p { color: var(--text-muted); font-size: 0.94rem; line-height: 1.7; }

  #proyecto { background: linear-gradient(160deg, var(--green-900), var(--green-800)); }
  .section-header { text-align: center; margin-bottom: 56px; }
  .proyecto-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: center; }
  .proyecto-block { padding: 8px; }
  .proyecto-block h3 { color: var(--gold); font-size: 1.4rem; margin-bottom: 16px; font-family: 'Playfair Display', serif; }
  .proyecto-block p { color: rgba(255,255,255,0.78); line-height: 1.85; font-size: 0.96rem; }
  .proyecto-image img { width: 100%; height: 320px; object-fit: cover; border-radius: var(--radius); border: 1px solid rgba(212,168,83,0.15); }
  .btn-primary { background: var(--gold); color: var(--green-900); }
  @media (max-width: 968px) { .servicios-grid { grid-template-columns: 1fr; } .proyecto-grid { grid-template-columns: 1fr; } }
</style>
